{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MdEv",
  "version": "0.8.0",
  "identifier": "com.mdev.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "wrrgit",
    "copyright": "Copyright © 2026 wrrgit",
    "category": "DeveloperTool",
    "shortDescription": "MdEv — Markdown 编辑器",
    "longDescription": "MdEv 是一款本地 Markdown 编辑器，支持实时预览、文件树、历史版本、跨文件搜索与 PDF/PNG/HTML 导出。",
    "homepage": "https://github.com/wrrgit/MdEv",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mdx"],
        "name": "Markdown Document",
        "description": "MdEv Markdown 文档",
        "mimeType": "text/markdown",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "nsis/header.bmp",
        "sidebarImage": "nsis/sidebar.bmp",
        "uninstallerHeaderImage": "nsis/header.bmp"
      }
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MdEv",
        "decorations": false,
        "width": 1200,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  }
}
