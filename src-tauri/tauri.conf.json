{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MdEv",
  "version": "0.8.0",
  "identifier": "com.mdev.editor",
  "build": {
    "frontendDist": "../spike-ui"
  },
  "bundle": {
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MdEv — Tauri Spike",
        "width": 1200,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  }
}
